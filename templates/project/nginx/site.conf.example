# Include this location snippet inside the existing domain's server block.
# Suggested location: /etc/nginx/business/<domain-id>/__BUSINESS__.conf
# APP_PORT=31001. Match this upstream to the allocated host port.
# For BASE_PATH=/starter, change `location /` to `location /starter/`.
# proxy_pass has NO trailing slash: the request path is preserved upstream.
location / {
    proxy_pass http://127.0.0.1:31001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
