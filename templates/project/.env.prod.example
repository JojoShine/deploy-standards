# Copy to /opt/__BUSINESS__/shared/.env.prod; chmod 600. Values are data, not shell code.
BUSINESS=__BUSINESS__
ENVIRONMENT=production
COMPOSE_PROJECT_NAME=__BUSINESS__-production
APP_PORT=31001
# Required external PostgreSQL URLs. Use different least-privilege app/migration roles.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Optional dedicated backup URL; omit to use MIGRATION_DATABASE_URL.
# BACKUP_DATABASE_URL=
PUBLIC_HEALTH_URL=
HEALTH_TIMEOUT=120
